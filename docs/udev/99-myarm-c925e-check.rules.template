# Inspection template only — do not install unchanged and do not use this
# alias as the runtime device_path. Runtime always uses /dev/v4l/by-id/... .
#
# First record attributes from the selected C925e endpoint:
#   udevadm info --attribute-walk --name=/dev/v4l/by-id/<selected>-video-index0
#
# Then replace all placeholders with attributes unique to the physical cam01
# and, if desired, install the resulting file under /etc/udev/rules.d/ for
# human-facing diagnostics only. Do not match just vendor/model: two identical
# C925e cameras require a unique USB path or serial attribute.
#
# SUBSYSTEM=="video4linux", KERNEL=="video*", ATTRS{serial}=="<CAM01_SERIAL>", \
#   ATTR{index}=="0", SYMLINK+="myarm/c925e_cam01_check"
