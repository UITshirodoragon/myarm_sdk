<?xml version="1.0"?>
<package format="3">
  <name>myarm_neugrasp</name>
  <version>0.1.0</version>
  <description>Sequential fake-scan and replay runtime nodes for NeuGrasp on MyArm M750.</description>
  <maintainer email="maintainer@example.com">myarm_sdk maintainers</maintainer>
  <license>All rights reserved</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>myarm_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <export><build_type>ament_python</build_type></export>
</package>
