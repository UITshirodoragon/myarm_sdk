Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /NeuGrasp Scene1
        - /TSDF Tensor Voxels1
        - /Grasp Tensor Wireframes1
        - /Scan Trajectory and View Axes (phase Scan only)1
        - /Selected Grasp Tool Target1
        - /Selected Grasp Wireframe1
        - /Pregrasp Wireframe1
        - /Lift Wireframe1
      Splitter Ratio: 0.5
    Tree Height: 760
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        flange_link:
          Value: true
        tool0:
          Value: true
        gripper_base_link:
          Value: true
        wrist_camera_link:
          Value: true
        wrist_camera_optical_frame:
          Value: true
        neugrasp_workspace:
          Value: true
        neugrasp_volume:
          Value: true
      Marker Scale: 0.07
      Name: Current Semantic TF Frames
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: true
        Expand Link Details: false
        Expand Tree: true
        Link Tree Style: Links in Tree Style
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true

    - Alpha: 1
      Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Neugrasp Scene
      Namespaces:
        workspace: true
      Queue Size: 10
      # ROS 2 Foxy Marker display stores this as a QoS-aware Topic property.
      # This exact shape is produced by adding a Marker manually in RViz2.
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /neugrasp/workspace_marker
      Value: true

    # neugrasp_replay derives this cloud from tsdf_vol.npy directly in the
    # target_frame local volume.  RGB8 is a generated near-surface TSDF colour
    # map, stored as the standard packed PointCloud2 `rgb` field.
    - Alpha: 0.82
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Name: TSDF Tensor Voxels
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.0075
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /neugrasp/tsdf_cloud
      Use Fixed Frame: true
      Value: true

    # neugrasp_replay reproduces NeuGrasp postprocessing from qual_vol_raw.npy,
    # rot_vol_raw.npy and width_vol_raw.npy, then renders each local candidate
    # gripper as this LINE_LIST marker in target_frame.
    - Alpha: 1
      Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Grasp Tensor Wireframes
      Namespaces:
        grasp_wireframes: true
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /neugrasp/grasp_wireframes
      Value: true

    # The scan action publishes this only while it is executing.  Its retained
    # DELETEALL snapshot clears a remote RViz as soon as the action completes,
    # cancels or aborts, before PREDICT_ARTIFACT begins.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Scan Trajectory and View Axes (phase Scan only)
      Namespaces:
        scan_route: true
        scan_frusta: true
        scan_labels: true
        scan_view_axes: true
      Queue Size: 1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /neugrasp/scan_view_markers
      Value: true

    # The trial coordinator publishes this PoseStamped in base_link.  Its
    # green axes are the actual tool0 target, rather than a model-frame grasp
    # pose, so it can be compared directly with RobotModel.
    - Alpha: 1
      Class: rviz_default_plugins/Pose
      Color: 0; 255; 0
      Enabled: true
      Axes Length: 0.07
      Axes Radius: 0.008
      Name: Selected Grasp Tool Target
      Shape: Axes
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /neugrasp/selected_grasp
      Value: true

    # These three retained snapshots show the selected grasp primitive in the
    # same base frame as the robot: green=grasp, cyan=pregrasp, purple=lift.
    - Alpha: 1
      Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Selected Grasp Wireframe
      Namespaces:
        selected_grasp: true
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /neugrasp/selected_grasp_marker
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Pregrasp Wireframe
      Namespaces:
        pregrasp: true
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /neugrasp/pregrasp_marker
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Lift Wireframe
      Namespaces:
        lift: true
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /neugrasp/lift_marker
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
    Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.35
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Rendering: false
        Value: false
      Focal Point:
        X: 0.05
        Y: 0.0
        Z: 0.35
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 0.65
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1800
  X: 50
  Y: 30
