<?xml version="1.0"?>
<package format="3">
  <name>myarm_robot_driver</name>
  <version>0.0.1</version>
  <description>ROS 2 driver boundary for the stateful MyArm M750 robot arm.</description>
  <maintainer email="maintainer@example.com">myarm_sdk maintainers</maintainer>
  <license>All rights reserved</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>myarm_description</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
