<?xml version="1.0"?>
<package format="3">
  <name>myarm_cartesian_trajectory</name>
  <version>0.0.1</version>
  <description>Plan-only Cartesian trajectory action and RViz preview for MyArm M750.</description>
  <maintainer email="maintainer@example.com">myarm_sdk maintainers</maintainer>
  <license>All rights reserved</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>myarm_description</exec_depend>
  <exec_depend>myarm_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <export><build_type>ament_python</build_type></export>
</package>
